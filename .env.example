# ========================================================
# CẤU HÌNH KẾT NỐI DATABASE MYSQL (PHPMYADMIN / XAMPP)
# ========================================================
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=restaurant_ordering_db
DB_USER=root
DB_PASS=

# ========================================================
# CẤU HÌNH TRỢ LÝ AI CHATBOT (GOOGLE GEMINI)
# ========================================================
# Lấy API Key Google Gemini miễn phí tại: https://aistudio.google.com/app/apikey
# Dán API Key vào biến bên dưới để kích hoạt AI hội thoại thực sự.
# Nếu để trống, hệ thống sẽ chạy ở chế độ Thử nghiệm (Demo) kèm thông báo minh bạch.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
AI_TIMEOUT=15
