<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # Cho phép truy cập trực tiếp file và thư mục thực tế trong public (css, js, images)
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d

    # Điều hướng mọi request khác về index.php
    RewriteRule ^(.*)$ index.php [QSA,L]
</IfModule>
